class Animal {
    public name: str;

    public init(name: str) {
        self.name = name;
    }

    public func speak(): str {
        return self.name;
    }
}

class Dog extends Animal {
    public override func speak(): str {
        return "woof " + self.name;
    }
}

let pet = new Dog("Rex");
print(pet.speak());
