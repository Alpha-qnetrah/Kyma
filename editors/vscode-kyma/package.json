{
  "name": "kyma-language-support",
  "displayName": "Kyma Language Support",
  "description": "Kyma syntax, completions, live diagnostics, imports, comments, and run/check tools.",
  "version": "0.2.1",
  "publisher": "kyma-lang",
  "license": "MIT",
  "icon": "assets/kyma-k.png",
  "galleryBanner": { "color": "#6D4AFF", "theme": "dark" },
  "keywords": ["kyma", "language", "interpreter", "tree-walk", "diagnostics"],
  "repository": { "type": "git", "url": "https://github.com/Up-to-code/Kyma.git" },
  "bugs": { "url": "https://github.com/Up-to-code/Kyma/issues" },
  "homepage": "https://github.com/Up-to-code/Kyma",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:kyma", "onCommand:kyma.runFile", "onCommand:kyma.checkFile"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "kyma",
      "aliases": ["Kyma", "ky"],
      "extensions": [".ky"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./assets/kyma-file-light.svg",
        "dark": "./assets/kyma-file-dark.svg"
      }
    }],
    "grammars": [{
      "language": "kyma",
      "scopeName": "source.kyma",
      "path": "./syntaxes/kyma.tmLanguage.json"
    }],
    "snippets": [{
      "language": "kyma",
      "path": "./snippets/kyma.json"
    }],
    "commands": [
      {
        "command": "kyma.runFile",
        "title": "Kyma: Run File",
        "icon": {
          "light": "./assets/run-light.svg",
          "dark": "./assets/run-dark.svg"
        }
      },
      {
        "command": "kyma.checkFile",
        "title": "Kyma: Check File",
        "icon": {
          "light": "./assets/check-light.svg",
          "dark": "./assets/check-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "kyma.runFile", "when": "editorLangId == kyma", "group": "navigation@1" },
        { "command": "kyma.checkFile", "when": "editorLangId == kyma", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "Kyma",
      "properties": {
        "kyma.executable": {
          "type": "string",
          "default": "",
          "description": "Kyma executable path. Empty auto-detects build/kyma in the workspace, then falls back to PATH."
        }
      }
    }
  }
}
